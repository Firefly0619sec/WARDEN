<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       WARDEN 卸载器（事故后重写，2026-10-10）
       · WinForms 确认窗（默认保留用户数据 ✓）
       · 复用 tools/setup 里的 StopToken.cs（写合法停止令牌，请主程序自己退出）✓
       · 自包含单文件 + 压缩
       ========================================================================== -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Uninstaller</AssemblyName>
    <RootNamespace>WardenUninstall</RootNamespace>
    <AssemblyTitle>WARDEN 卸载程序</AssemblyTitle>
    <Product>WARDEN</Product>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.3.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- ★ 2026-10-11 Beta 3：原生 AOT（界面已改为原生 Win32/GDI ✓）
         体积从 49.25 MB 降到约 1 MB ✓ 且目标机不需要装 .NET ✓ -->
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- ★ 复用安装器里的停止令牌实现（同一份逻辑，避免两边不一致 ✗） -->
  <ItemGroup>
    <Compile Include="..\setup\StopToken.cs">
      <Link>StopToken.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
