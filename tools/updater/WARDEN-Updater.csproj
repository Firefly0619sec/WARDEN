<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       WARDEN 更新器（事故后重写，2026-10-10）
       · 离线更新包（zip）安装 + 哈希校验 + 自动备份便于回滚 ✓
       · 复用 tools/setup/StopToken.cs（写合法停止令牌请主程序退出）✓
       · 自包含单文件 + 压缩
       ========================================================================== -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Updater</AssemblyName>
    <RootNamespace>WardenUpdater</RootNamespace>
    <AssemblyTitle>WARDEN 更新程序</AssemblyTitle>
    <Product>WARDEN</Product>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.3.1</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Beta 3（0.3.1）：界面改用原生接口（UpdaterWin32.cs）✓ 可开 AOT ✓ 49.24MB → 约 1MB -->
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\setup\StopToken.cs">
      <Link>StopToken.cs</Link>
    </Compile>
    <!-- ★ 0.3.6（AP0）：复用 setup 的 PGP 校验器（内嵌公钥 + 指纹写死 ✓ 自包含 ✓ AOT 安全 ✓） -->
    <Compile Include="..\setup\PgpVerify.cs">
      <Link>PgpVerify.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
