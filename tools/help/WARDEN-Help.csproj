<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================================================
       WARDEN 帮助中心（新手教程 + 反馈）

       【为什么单独一个 exe】（用户 2026-10-10）
           用户要求加"教程页"和"反馈页"
           主程序是 Native AOT，用不了 WinForms
           → 单独做一个 exe，和五个组件一样的模式（独立、可单独更新）

       【为什么教程不用 Markdown 渲染库】
           本来可以引 Markdig（BSD-2-Clause，与 AGPL-3.0 兼容）
           但那会增加一个 NuGet 依赖
           → 改成语言包驱动的结构化教程：
               正文全在语言包里，翻译者改语言包就能出外语版
               零第三方依赖，也不用操心协议 ✓
       ======================================================================== -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WARDEN-Help</AssemblyName>
    <RootNamespace>WardenHelp</RootNamespace>
    <Version>0.2.1</Version>
    <Product>WARDEN 帮助中心</Product>
    <Authors>Firefly0619sec</Authors>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>

    <PublishAot>false</PublishAot>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <ApplicationIcon>WARDEN.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="WARDEN.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="zh-Hans.txt" />
  </ItemGroup>

</Project>
