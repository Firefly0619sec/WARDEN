<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       WARDEN 安装程序（事故后重写，2026-10-10）
       · WinForms 向导（环境检测 / 安装位置 / 完成）
       · 自包含单文件 + 压缩（用户机器不需要装 .NET ✓）
       · 内嵌载荷 payload.zip（含 WARDEN 主程序 + 5 个工具 + 可选的红队自测工具）
       ========================================================================== -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WARDEN-Setup</AssemblyName>
    <RootNamespace>WardenSetup</RootNamespace>
    <AssemblyTitle>WARDEN 安装程序</AssemblyTitle>
    <Product>WARDEN</Product>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.1.0-beta.1</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>   <!-- ★ 省掉 ICU 那 20 多 MB ✓ -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- ★ 载荷：必须是 EmbeddedResource，且 LogicalName 固定为 payload.zip ✓ -->
  <ItemGroup>
    <EmbeddedResource Include="payload.zip">
      <LogicalName>payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
