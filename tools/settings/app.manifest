<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     WARDEN 设置工具 —— 原生 AOT 版应用程序清单（2026-10-11 · 0.3.3）

     【为什么这个文件是必需的】（不是可有可无的装饰 ✗）

       ★ comctl32 v6 依赖声明：
         设置界面用了两个【通用控件】：SysTabControl32（页签）与
         SysListView32（规则表，LVS_REPORT + LVS_EX_CHECKBOXES 复选框）✓
         没有这份清单时，进程加载的是 comctl32 第 5 版 ✗
           → 规则表第一列的「启用」复选框会画成旧的 +/- 方框 ✗
           → 页签的选项卡高度/边框也退回旧样式 ✗
         参考：src\app.manifest 里记着同一类坑（那时是 TaskDialogIndirect 找不到入口 ✗）

       ★ 高 DPI 感知：WinForms 版是 .NET 自动加上的 ✗ 原生版必须自己声明 ✓
          代码里同时调 SetProcessDpiAwarenessContext(-4)（PER_MONITOR_AWARE_V2 ✓）
          清单 + 代码双保险：高 DPI 下窗口与控件一起放大 ✓
          验证钩子：环境变量 WARDEN_TEST_DPI=120/144（见 SettingsWin32.cs ✓）

       ★ asInvoker：设置工具改的是用户自己的配置文件，不需要管理员 ✓
     ============================================================================ -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="0.3.3.0" name="WARDEN.Settings" />

  <!-- ★ 通用控件 v6：页签与规则表的现代外观 + 复选框的前提 -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32"
                        name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0"
                        processorArchitecture="*"
                        publicKeyToken="6595b64144ccf1df"
                        language="*" />
    </dependentAssembly>
  </dependency>

  <!-- 兼容性：Win10 / 11 / 8.1 / 8 / 7 -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
    </application>
  </compatibility>

  <!-- 不提权 -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- 高 DPI 感知（与 WARDEN 本体一致 ✓） -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
    </windowsSettings>
  </application>

</assembly>
