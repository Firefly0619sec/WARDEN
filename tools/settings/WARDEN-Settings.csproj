<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================================================
       WARDEN 设置工具 —— 原生 Win32/GDI + Native AOT（2026-10-11 · 0.3.3）

       【为什么要单独一个工程】
           用户反馈：原来的 PowerShell 版设置界面 ✗
             关掉 PS 的控制台窗口 → 界面一起消失 ✗
             因为 powershell.exe 就是界面的宿主 ✗
           → 改成独立的 exe ✓ 双击就跑 ✓ 不依赖 PowerShell ✓

       【★ 为什么不再用 WinForms】（Beta 3 的最后一站 ✓）
           · WinForms 在 Native AOT 下【不可用】✗（PublishAot 直接编译失败 ✓）
           · 原来只能 SelfContained 单文件 = 47.03 MB ✗
             而真正的界面代码只有几百 KB ✓
           → 界面改写成原生控件（SysTabControl32 / SysListView32 / EDIT /
             BUTTON / COMBOBOX / msctls_updown32 ✓ 见 SettingsWin32.cs ✓）
           → 与 uninstaller 0.3.0 / updater 0.3.1 / logview 0.3.2 同一套做法 ✓
           → 产物一个 exe 几 MB，机器上不用装 .NET ✓

       【★ app.manifest 是必需的】
           规则表第一列是复选框（LVS_EX_CHECKBOXES）、页签是 SysTabControl32 ✓
           没有 comctl32 v6 清单 → 加载的是第 5 版 ✗ 复选框画成旧式 +/- 方框 ✗
           （WinForms 版是 .NET 自动加清单的 ✗ 原生版必须自己声明 ✓）
       ======================================================================== -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- ★ WinForms 彻底退场（这也是能开 AOT 的前提 ✓） -->
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Settings</AssemblyName>
    <RootNamespace>WardenSettings</RootNamespace>
    <Version>0.3.3</Version>
    <Product>WARDEN 设置工具</Product>
    <Authors>Firefly0619sec</Authors>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>

    <!-- ★ 原生 AOT：一个自包含的 exe，不依赖目标机装 .NET ✓ -->
    <PublishAot>true</PublishAot>
    <!-- ★ 窗口过程要用 delegate* unmanaged[Stdcall] 与指针（unsafe ✓） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ★ 这个工具不做区域性相关的格式化 → 关掉 ICU 依赖，体积更小 ✓ -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- ★ 体积优先（用户要求产物 < 8 MB ✓） -->
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <!-- ★ 符号剥离（发布产物不带 .pdb ✓） -->
    <StripSymbols>true</StripSymbols>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantTimezone>true</InvariantTimezone>
    <!-- ★ comctl32 v6 + 高 DPI 感知（见文件头说明 ✓） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <!-- ★ 去掉 WinForms 之后这里不再需要单文件/裁剪/压缩那套（AOT 本身就是单文件 ✓） -->
  </PropertyGroup>

  <!-- ★ 语言包作为内嵌资源（找不到外部语言包时用它保底） -->
  <ItemGroup>
    <EmbeddedResource Include="zh-Hans.txt" />
  </ItemGroup>

</Project>
