<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       WARDEN 红队自测工具（原生 AOT，纯 Win32，不用 WinForms）
       ★ 和 WARDEN 本体一个路子：小、快、不依赖 .NET 运行时 ✓
       ========================================================================== -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>RedTeam</AssemblyName>
    <RootNamespace>WardenRedTeam</RootNamespace>
    <AssemblyTitle>WARDEN 红队自测工具</AssemblyTitle>
    <Product>WARDEN</Product>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.3.3</Version>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
